# Copy to .env and fill in. .env itself is gitignored and must never be committed.
#
# The MSG91 account authkey is the server-facing half of MSG91. It is read only by
# server/src/msg91.js, always at request time, always as an HTTP header, and it is
# never returned to the browser, never logged, and never placed in a VITE_ variable.
MSG91_AUTHKEY=

# The browser-facing half of the MSG91 OTP Widget, from the widget's own settings in
# the MSG91 panel (OTP -> OTP Widget -> your widget). These two are what the Web SDK
# is configured with in the browser; the server hands them out from
# GET /api/auth/msg91-widget-config, which is why the client needs no .env of its own.
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=

# Set to false to refuse customer sign-in with a clear message instead of sending
# codes. Useful for taking the SMS path down without unsetting the keys above.
MSG91_OTP_ENABLED=true

NODE_ENV=development
PORT=5000

# Sign and verify every session token. With server/src/env.js loaded before the
# modules that read it, this value is the one actually used - previously the modules
# captured the environment before dotenv ran and silently fell back to a hardcoded
# development secret.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Staff sign-in only. Staff codes are still generated and logged by this server, so
# "console" is the development provider. It has no effect on customers, whose codes
# belong to MSG91.
OTP_PROVIDER=console
